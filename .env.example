# -----------------------------------------------------------------------------
# AI Data Science Workbench - example environment configuration.
# Copy to `.env` and fill in as needed. None of these are required for the
# local (offline) pipeline stages; they only affect the Kaggle download.
# -----------------------------------------------------------------------------

# Optional Kaggle credentials. kagglehub can also read ~/.kaggle/kaggle.json.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional override for the workbench log level (DEBUG, INFO, WARNING, ERROR).
WORKBENCH_LOG_LEVEL=INFO
